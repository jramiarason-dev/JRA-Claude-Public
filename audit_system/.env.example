# Backend key for the Claude API. Required — the app refuses to start without it.
ANTHROPIC_API_KEY=your-api-key-here

# Shared sign-in password. Optional.
#   set    → the sign-in screen requires this password
#   unset  → the app is open to anyone who reaches the URL (demo mode)
# On Streamlit Cloud, set both of these under App settings → Secrets instead.
AUDITIQ_PASSWORD=
